# BO3 NX toolchain. See docs/NX_PORT.md for the NFSMW reference and ABI notes.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(DEVKITPRO "C:/devkitPro" CACHE PATH "devkitPro installation")
set(BO3_NX_MESA_SDK "${DEVKITPRO}/portlibs/switch" CACHE PATH "Horizon Mesa portlibs")
if(CMAKE_HOST_WIN32)
    set(_suffix .exe)
endif()
set(_bin "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-")
set(CMAKE_C_COMPILER "${_bin}gcc${_suffix}")
set(CMAKE_CXX_COMPILER "${_bin}g++${_suffix}")
set(CMAKE_ASM_COMPILER "${_bin}gcc${_suffix}")
set(CMAKE_AR "${_bin}gcc-ar${_suffix}")
set(CMAKE_RANLIB "${_bin}gcc-ranlib${_suffix}")
set(CMAKE_NM "${_bin}nm${_suffix}")
set(CMAKE_STRIP "${_bin}strip${_suffix}")
set(_arch "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIE -D__SWITCH__ -D_GNU_SOURCE -DSPDLOG_NO_TZ_OFFSET")
set(CMAKE_C_FLAGS_INIT "${_arch} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${_arch} -ffunction-sections -fdata-sections")
set(CMAKE_ASM_FLAGS_INIT "${_arch}")
# Resolve the linker script without depending on an inherited /opt environment.
file(READ "${DEVKITPRO}/libnx/switch.specs" _specs)
string(REPLACE "%:getenv(DEVKITPRO /libnx/switch.ld)" "${DEVKITPRO}/libnx/switch.ld" _specs "${_specs}")
file(WRITE "${CMAKE_BINARY_DIR}/switch.specs" "${_specs}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=${CMAKE_BINARY_DIR}/switch.specs -Wl,--no-relax")
include_directories(SYSTEM "${DEVKITPRO}/libnx/include" "${BO3_NX_MESA_SDK}/include")
link_directories("${DEVKITPRO}/libnx/lib" "${BO3_NX_MESA_SDK}/lib")
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/devkitA64" "${DEVKITPRO}/libnx" "${BO3_NX_MESA_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
